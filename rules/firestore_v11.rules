rules_version = '2';
// 해운대 룸메이드 정비 레포트 — Firestore 보안 규칙 (v1 2026-10-31, v2 2026-11-05: 휴대폰 오류 기록 errors 추가, v3 2026-11-05: 정비보고서 올림 uploads 추가,
//   v4 2026-11-05: 정비 지원(정비보조 더티 체크·출퇴근) sup · sup_meta 추가, v5 2026-11-06: 정비 지원 객실 활동판 acts 추가,
//   v6 2026-11-07: 2인 1조(부부 메이드) — meta/teams.mate 에 짝으로 적힌 메이드는 짝의 배정·기록·변경·공지 확인을 같이 읽고 씀,
//   v7 2026-11-07: 고객만족도 VOC voc/{id} — 관리자(소장·부소장·봇)만 읽고 씀 (메이드 실적 비공개). 그 밖은 v6 와 같음,
//   v8 2026-11-07: 재고조사 inv_* 추가 (부소장 Claude, haeundae-rm/inventory). 그 밖은 v7 와 한 글자도 같음,
//   v9 2026-11-07: 재고조사 기록 qty 에 null(지움 = 안 셈으로 되돌림) 허용. 그 밖은 v8 와 한 글자도 같음,
//   v10 2026-11-09: 재고조사 구분에 '사무실' 추가 (객실 · 사우나 · 사무실). 그 밖은 v9 와 한 글자도 같음,
//   v11 2026-11-09: 가구 보수 이력 inv_repairs 추가 (근무자는 '접수' 줄 만들기만, 완료·고치기·지우기는 관리자). 그 밖은 v10 와 한 글자도 같음)
// 원칙: 메이드는 본인 이름으로 등록된 휴대폰에서 본인(과 2인 1조 짝) 기록만 쓰고, 본인(과 짝) 배정만 읽는다 (다른 메이드 배정 비노출)
//       관리자(소장·부소장)와 봇(Apps Script 중계)은 전부 읽고 쓴다
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- 공통
    function signedIn() { return request.auth != null; }
    // 소장 · 부소장 · 봇
    function isAdmin() {
      return signedIn() && request.auth.uid in [
        'wytSL9o4vvN4U2G3z6R64hafC9t2',
        'Fz4T5ZzIxShOdVkNpF9gzMmOLED2',
        'iw2orXgIgPgTbLUQa0b41XJ9Dvd2'
      ];
    }
    function devPath() { return /databases/$(db)/documents/devices/$(request.auth.uid); }
    function hasDev() { return signedIn() && exists(devPath()); }
    function myName() { return get(devPath()).data.name; }
    function isMe(name) { return hasDev() && myName() == name; }
    // v6: 2인 1조 짝 (meta/teams.mate = {이름: 짝 이름}, 관리자만 고침). 없으면 ''
    function teamsPath() { return /databases/$(db)/documents/meta/teams; }
    function myMate() { return exists(teamsPath()) ? get(teamsPath()).data.get('mate', {}).get(myName(), '') : ''; }
    function isMine(name) { return hasDev() && name is string && name != '' && (myName() == name || myMate() == name); }
    function isRoom(r) { return r is string && r.matches('^[0-9]{3,4}$'); }
    function isName(n) { return n is string && n.size() > 0 && n.size() <= 20; }

    // ---------- 휴대폰 등록: 메이드가 이름을 고르면 만들어짐. 바꾸기·해제는 관리자만
    match /devices/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list, delete: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'date', 'at'])
        && isName(request.resource.data.name)
        && request.resource.data.at == request.time
        && request.resource.data.date is string
        && exists(/databases/$(db)/documents/days/$(request.resource.data.date))
        && request.resource.data.name in get(/databases/$(db)/documents/days/$(request.resource.data.date)).data.maids;
      allow update: if isAdmin();
    }

    // ---------- 하루 배정
    match /days/{date} {
      // 날짜·이름 목록(이름 고르기 화면) — 로그인한 누구나
      allow read: if signedIn();
      allow write: if isAdmin();

      // 메이드별 배정: 본인(과 짝) 것만 열람
      match /plans/{name} {
        allow get: if isAdmin() || isMine(name);
        allow list, write: if isAdmin();
      }

      // 객실 → 담당자 (교환할 때 상대 이름 확인). 한 객실씩만 열람, 목록 금지
      match /owners/{room} {
        allow get: if hasDev() || isAdmin();
        allow list, write: if isAdmin();
      }

      // 정비 기록: 객실마다 문서 하나 ({객실}_{이름}). 같은 객실을 다시 누르면 덮어씀
      // v6: 2인 1조 휴대폰은 짝 이름으로도 기록 (기록 이름 = 배정받은 분 → 실적은 각자 그대로)
      match /recs/{id} {
        allow read: if isAdmin() || (hasDev() && isMine(resource.data.maid));
        allow create, update: if validRec(id) && (
             isAdmin()
          || (isMine(request.resource.data.maid)
              && request.resource.data.proxy == false
              && exists(/databases/$(db)/documents/days/$(date)/plans/$(request.resource.data.maid))));
        allow delete: if isAdmin();
      }
      function validRec(id) {
        let d = request.resource.data;
        return d.keys().hasOnly(['room', 'maid', 'status', 'issues', 'memo', 'at', 'clientAt', 'uid', 'proxy'])
          && isRoom(d.room) && isName(d.maid) && id == d.room + '_' + d.maid
          && d.status in ['완료', '이상', '취소']
          && d.issues is list && d.issues.size() <= 5
          && d.memo is string && d.memo.size() <= 300
          && d.at == request.time
          && d.clientAt is timestamp
          && d.uid == request.auth.uid
          && d.proxy is bool;
      }

      // 근무 중 객실 추가 · 제외 · 교환: 줄을 쌓기만 함 (고치기·지우기 없음)
      match /changes/{id} {
        allow read: if isAdmin() || (hasDev() && (myName() in resource.data.parties || (myMate() != '' && myMate() in resource.data.parties)));
        allow create: if validChange() && (
             isAdmin()
          || (isMine(request.resource.data.maid) && request.resource.data.by == '본인'));
        allow update, delete: if isAdmin();
      }
      function validChange() {
        let d = request.resource.data;
        return d.keys().hasOnly(['kind', 'maid', 'room', 'to', 'toRoom', 'by', 'at', 'clientAt', 'uid', 'parties'])
          && d.kind in ['추가', '제외', '교환']
          && isName(d.maid) && isRoom(d.room)
          && d.by in ['본인', '관리자']
          && d.at == request.time && d.clientAt is timestamp && d.uid == request.auth.uid
          && d.parties is list && d.maid in d.parties && d.parties.size() <= 2
          && (d.kind != '교환' || (isName(d.to) && isRoom(d.toRoom) && d.to != d.maid && d.to in d.parties));
      }

      // 공지 확인 ({공지ID}_{이름})
      match /acks/{id} {
        allow read: if isAdmin() || (hasDev() && isMine(resource.data.maid));
        allow create: if (isAdmin() || isMine(request.resource.data.maid))
          && request.resource.data.keys().hasOnly(['notice', 'maid', 'at'])
          && id == request.resource.data.notice + '_' + request.resource.data.maid
          && request.resource.data.at == request.time;
        allow update, delete: if isAdmin();
      }
    }

    // ---------- 공지 · 앱 설정(버전 · 2인 1조 teams 등)
    match /notices/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /meta/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- 고객만족도 VOC (v7, 2026-11-07): 건마다 문서 하나 (분류·마지막 정비자). 메이드 개인 실적이 들어 있어 관리자만
    match /voc/{id} {
      allow read, write: if isAdmin();
    }

    // ---------- 휴대폰 오류 기록 (v2, 2026-11-05): 로그인한 휴대폰이 자기 오류를 한 줄씩 남김. 보기·지우기는 관리자만
    match /errors/{id} {
      allow read, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['at', 'day', 'uid', 'name', 'ver', 'where', 'msg', 'ua'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.day is string && request.resource.data.day.size() == 10
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 500
        && request.resource.data.where is string && request.resource.data.where.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.ver is string && request.resource.data.ver.size() <= 20
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200;
    }

    // ---------- 정비보고서 올림 (v3, 2026-11-05): 관리자 앱이 만든 배정표(csv) → 중계가 드라이브·배정 탭에 넣음
    // 모든 메이드 배정이 들어 있어서 관리자(소장·부소장·봇)만 읽고 씀
    match /uploads/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.csv is string && request.resource.data.csv.size() <= 500000;
    }

    // ---------- 정비 지원 (v4, 2026-11-05 ⑧): 정비보조 더티 체크 · 담당 변경 · 출퇴근
    // 정비보조는 이름 등록 없이(예전 앱과 같이) 익명 로그인. 읽기는 로그인한 누구나 (객실·이름·시각뿐 — 정비보조는 원래 전체를 봄)
    // 쓰기는 '줄 만들기'만 (고치기·지우기 없음 → 기록이 쌓이고 아래 줄이 위 줄을 덮음). 관리자 일은 소장·부소장·봇만
    match /sup/{date} {
      allow read: if signedIn();
      allow write: if isAdmin();   // 하루 배정(plan) — 중계(봇)가 씀
      match /rows/{id} {
        allow read: if signedIn();
        allow create: if isAdmin() || validSupRow(date);
        allow update, delete: if isAdmin();
      }
    }
    function str(v, n) { return v is string && v.size() <= n; }
    function supRoom(v) { return v is string && v.matches("^'?[0-9]{3,4}$"); }
    // 정비보조 본인 줄: row = 시트 한 줄 그대로 (첫 칸 시각은 비워 두고 at 로) — 칸 수·종류·글자 수 검사
    function validSupRow(date) {
      let d = request.resource.data;
      let r = d.row;
      return d.keys().hasOnly(['tab', 'row', 'at', 'clientAt', 'uid', 'by'])
        && d.at == request.time && d.clientAt is timestamp && d.uid == request.auth.uid && d.by == '본인'
        && r is list && r.size() >= 7 && r.size() <= 9 && r[0] == null && r[1] == date
        && ((d.tab == '체크' && r.size() == 7 && supRoom(r[2]) && isName(r[3]) && isName(r[4]) && r[5] in ['완료', '취소'] && r[6] == '')
         || (d.tab == '변경' && r.size() == 9 && r[2] in ['가져옴', '수정', '되돌림', '넘겨받음'] && isName(r[3]) && isName(r[4])
             && str(r[5], 300) && (r[6] == '' || r[6] is int) && str(r[7], 300) && str(r[8], 20))
         || (d.tab == '근태' && r.size() == 8 && isName(r[2]) && r[3] in ['출근', '퇴근', '퇴근취소', '업무']
             && r[4] in ['', '더티', '기타 업무'] && str(r[5], 60) && r[6] == '본인' && r[7] == ''));
    }
    match /sup_meta/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();   // names(최근 근무자) · relay(중계 상태) — 중계(봇)가 씀
    }

    // ---------- 정비 지원 객실 활동판 (v5, 2026-11-06 ⑧ 2부)
    // 활동 = acts/{활동ID} (만들기·수정·끝내기·보관은 소장·부소장·봇만), 객실 체크 = acts/{활동ID}/marks/{객실} (같은 객실은 덮어씀)
    // 정비보조: 진행 중인 활동에만, 본인 이름으로, 완료·이상·취소 (메모는 이상일 때만 30자). '관리자 대신'·지우기는 관리자만
    match /acts/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /marks/{room} {
        allow read: if signedIn();
        allow create, update: if isAdmin() || validMark(id, room);
        allow delete: if isAdmin();
      }
    }
    function validMark(id, room) {
      let d = request.resource.data;
      return d.keys().hasOnly(['s', 'm', 'w', 'by', 'at', 'clientAt', 'uid'])
        && room.matches('^[0-9]{3,4}$')
        && d.s in ['완료', '이상', '취소'] && str(d.m, 30) && (d.s == '이상' || d.m == '')
        && isName(d.w) && d.w != '관리자' && d.by == '본인'
        && d.at == request.time && d.clientAt is timestamp && d.uid == request.auth.uid
        && get(/databases/$(db)/documents/acts/$(id)).data.status == '진행';
    }
    // ---------- 재고조사 (v8, 2026-11-07): haeundae-rm/inventory 앱. 컬렉션은 inv_ 로 시작하는 것만
    // 품목·회차·구매신청서는 관리자(소장·부소장·봇)만 씀. 근무자(하우스맨·사우나, 익명 로그인)는 진행 중인 회차에 '조사 한 줄 쌓기'만
    match /inv_items/{id} {        // 품목 (객실 / 사우나, 창고·단위·순서·사용)
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /inv_rounds/{id} {       // 회차 'YYYY-MM' (진행/마감, 전월이월·당월입고 고친 값, 마감 때 최종 재고)
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /inv_buy/{id} {          // 사우나 구매신청서 (회차마다 하나) — 관리자만
      allow read, write: if isAdmin();
    }
    match /inv_counts/{id} {       // 조사 한 줄 = 회차·구분·품목·수량·누가 (같은 품목은 마지막 줄이 지금 값)
      allow read: if signedIn();
      allow create: if isAdmin() || validInvCount();
      allow update, delete: if isAdmin();
    }
    function validInvCount() {
      let d = request.resource.data;
      return signedIn()
        && d.keys().hasOnly(['round', 'part', 'item', 'qty', 'by', 'at', 'clientAt', 'uid'])
        && d.round is string && d.round.matches('^[0-9]{4}-[0-9]{2}$')
        && d.part in ['객실', '사우나', '사무실']   // v10: 사무실 추가
        && d.item is string && d.item.size() > 0 && d.item.size() <= 40
        && (d.qty == null || (d.qty is int && d.qty >= 0 && d.qty <= 100000))   // v9: null = 지움(안 셈)
        && isName(d.by)
        && d.at == request.time && d.clientAt is timestamp && d.uid == request.auth.uid
        && exists(/databases/$(db)/documents/inv_rounds/$(d.round))
        && get(/databases/$(db)/documents/inv_rounds/$(d.round)).data.status == '진행';
    }
    match /inv_repairs/{id} {      // v11: 가구 보수 이력 — 날짜·호실·품목·수량·접수자·비고·입력자·상태(접수/완료)
      allow read: if signedIn();
      allow create: if isAdmin() || validRepair();
      allow update, delete: if isAdmin();   // 완료 처리 · 되돌리기 · 삭제는 관리자만
    }
    function validRepair() {
      let d = request.resource.data;
      return signedIn()
        && d.keys().hasOnly(['date', 'room', 'item', 'qty', 'by', 'memo', 'who', 'status', 'at', 'clientAt', 'uid'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isRoom(d.room)
        && d.item is string && d.item.size() > 0 && d.item.size() <= 30
        && d.qty is int && d.qty >= 1 && d.qty <= 50
        && d.by is string && d.by.size() > 0 && d.by.size() <= 20
        && d.memo is string && d.memo.size() <= 100
        && isName(d.who) && d.status == '접수'
        && d.at == request.time && d.clientAt is timestamp && d.uid == request.auth.uid;
    }
    match /inv_errors/{id} {       // 재고 앱 휴대폰 오류 기록 (errors 와 같은 모양, 따로 보관)
      allow read, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['at', 'day', 'uid', 'name', 'ver', 'where', 'msg', 'ua'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.day is string && request.resource.data.day.size() == 10
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 500
        && request.resource.data.where is string && request.resource.data.where.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.ver is string && request.resource.data.ver.size() <= 20
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200;
    }

    // 그 밖의 모든 곳은 막힘 (규칙에 없는 경로는 기본 거부)
  }
}
